{
  "name": "paidmcp-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.includes('pnpm')) { console.error('Use pnpm in this repo (run: pnpm install).'); process.exit(1); }\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,md,yml,yaml,css}\"",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,md,yml,yaml,css}\"",
    "validate:data": "node scripts/validate-directory.mjs",
    "check": "pnpm run validate:data && pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
